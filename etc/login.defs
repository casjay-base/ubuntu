# *REQUIRED*
MAIL_DIR           Maildir/
PASS_MAX_DAYS      9999
PASS_MIN_DAYS      1
PASS_MIN_LEN       12
PASS_WARN_AGE      12
UID_MIN            10000
UID_MAX            50000
GID_MIN            10000
GID_MAX            50000
CREATE_HOME        yes
UMASK              077
USERGROUPS_ENAB    yes
ENCRYPT_METHOD     SHA512

