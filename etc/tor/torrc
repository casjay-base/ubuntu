# =========================================================
#  🕳️ Tor Exit Node Configuration – Limited, Hardened, Accounted
#  📅 Monthly 1000GB, 🌐 Safe Ports Only, 🛡️ Abuse-Minimized
# =========================================================

# =========================================================
# 🔧 Basic Setup
# =========================================================
RunAsDaemon                 1
DataDirectory               /var/lib/tor

# =========================================================
# 🔐 Control Port
# =========================================================
ControlPort                 9051
ControlSocket               /run/tor/control.sock
CookieAuthFile              /run/tor/control.authcookie
ControlSocketsGroupWritable 1
CookieAuthentication        1
CookieAuthFileGroupReadable 1

# =========================================================
# 🌐 SOCKS/DNS/HTTP Tunnel — client-proxy only, no relay/exit,
# not advertised to the Tor network. Bound to loopback + all
# interfaces for LAN reach; SocksPolicy restricts SOCKS to
# loopback + private ranges. HTTPTunnelPort/DNSPort have no
# equivalent Tor-side ACL directive, so firewalld is what keeps
# them closed: neither 9080 nor 9053 is listed in
# firewalld/zones/public.xml (the default zone, deny-by-default)
# nor in docker.xml (target REJECT), so both stay unreachable
# from every network. Never add them to a zone.
# =========================================================
SOCKSPort                   0.0.0.0:9050 IsolateDestAddr IsolateDestPort
SOCKSPort                   [::]:9050    IsolateDestAddr IsolateDestPort
SocksPolicy                 accept 127.0.0.0/8
SocksPolicy                 accept 10.0.0.0/8
SocksPolicy                 accept 172.16.0.0/12
SocksPolicy                 accept 192.168.0.0/16
SocksPolicy                 accept6 ::1/128
SocksPolicy                 accept6 fc00::/7
SocksPolicy                 reject *
SocksPolicy                 reject6 *
HTTPTunnelPort              0.0.0.0:9080
HTTPTunnelPort              [::]:9080
DNSPort                     0.0.0.0:9053
DNSPort                     [::]:9053
AutomapHostsOnResolve       1
AutomapHostsSuffixes        .exit,.onion

# =========================================================
# 🚫 Not a relay or exit node — no ORPort, no ExitRelay, no
# ExitPolicy, no relay identity/bandwidth accounting.
# =========================================================
ExitRelay                   0

# =========================================================
# 🧾 Logging
# =========================================================
Log                         notice file /var/log/tor/tor.log

# =========================================================
# 🏃 Performance
# =========================================================
AvoidDiskWrites             1
DisableAllSwap              1
HardwareAccel               1
NumCPUs                     2
