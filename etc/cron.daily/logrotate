#!/usr/bin/env sh

# RHEL 9 rotates via logrotate.timer, not cron. Running both means two passes a
# day, and under "rotate 0" the second pass can discard a log the first one just
# created. The timer owns rotation wherever it exists; this cron entry is only a
# fallback for hosts that have no logrotate.timer at all.
if systemctl list-unit-files logrotate.timer >/dev/null 2>&1; then
  exit 0
fi

/usr/sbin/logrotate /etc/logrotate.conf >/dev/null 2>&1
EXITVALUE=$?
if [ $EXITVALUE != 0 ]; then
  /usr/bin/logger -t logrotate "ALERT exited abnormally with [$EXITVALUE]"
fi
exit 0
